# Firebase (client SDK — public by design, restricted by firestore.rules / storage.rules)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server-only, used for audit_log writes / privileged actions)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Claude API (Anthropic) — reserved for future AI-assisted features
ANTHROPIC_API_KEY=

# Billing (iyzico — bkz. src/lib/billing/providers/iyzico.ts)
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=

# Telegram (kritik olay bildirimleri — yeni abonelik, iptal, ödeme hatası, eksik veri taraması)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Resend (e-posta altyapısı)
RESEND_API_KEY=
RESEND_FROM_EMAIL=KarbonRota <bildirim@karbonrota.com>

# Vercel Cron koruması (bkz. src/app/api/cron/*)
CRON_SECRET=

# Admin panel erişimi (bkz. /admin)
SUPERADMIN_UID=

# SEO / analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_SITE_URL=https://karbonrota.com
